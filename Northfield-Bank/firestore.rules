rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An admin is a signed-in user who has a document at supportAgents/{their UID} with role = "admin"
    function isSupport() {
      return signedIn()
        && exists(/databases/$(database)/documents/supportAgents/$(request.auth.uid))
        && get(/databases/$(database)/documents/supportAgents/$(request.auth.uid)).data.role == 'admin';
    }

    // Customer accounts, balances and transactions
    match /users/{document=**} {
      allow read, write: if signedIn();
    }

    // Live chat
    match /chatSessions/{uid} {
      allow create, read, update: if signedIn() && (request.auth.uid == uid || isSupport());
      allow delete: if isSupport();

      match /messages/{messageId} {
        allow read, create: if signedIn() && (request.auth.uid == uid || isSupport());
        allow update, delete: if isSupport();
      }
    }
  }
}
